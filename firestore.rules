rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function tripDoc(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)); }
    function isMember(tripId) { return signedIn() && me() in tripDoc(tripId).data.members; }

    // ---------- Trips ----------
    match /trips/{tripId} {
      // Members can read (also covers the "my trips" query: where members array-contains uid).
      allow read: if signedIn() && me() in resource.data.members;

      // Create: you must be the owner and the only member.
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.members == [me()];

      // Update:
      //  - any member can edit the plan as long as the member list is unchanged,
      //  - a member can remove only themselves (leave),
      //  - the owner can change members,
      //  - a non-member can add only themselves with a valid invite code.
      allow update: if signedIn() && (
        (me() in resource.data.members
          && request.resource.data.ownerId == resource.data.ownerId
          && (request.resource.data.members == resource.data.members
              || request.resource.data.members == resource.data.members.removeAll([me()])
              || resource.data.ownerId == me()))
        || joining(tripId));

      allow delete: if signedIn() && resource.data.ownerId == me();

      function joining(tripId) {
        let code = request.resource.data.joinCode;
        let inviteRef = /databases/$(database)/documents/invites/$(code);
        return code is string
          && exists(inviteRef)
          && get(inviteRef).data.tripId == tripId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'joinCode'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([me()].toSet());
      }

      // Group chat: members read; you can only post as yourself and edit/delete your own messages.
      match /messages/{msgId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.uid == me();
        allow update, delete: if isMember(tripId) && resource.data.uid == me();
      }
      // Expenses and packing list: any member can add/edit/delete.
      match /expenses/{id} { allow read, write: if isMember(tripId); }
      match /packing/{id} { allow read, write: if isMember(tripId); }
    }

    // ---------- Invites ----------
    // The code itself is the secret: anyone signed in can read an invite by its exact code,
    // nobody can list them, and only trip members can create/delete them.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.by == me() && isMember(request.resource.data.tripId);
      allow delete: if signedIn() && isMember(resource.data.tripId);
    }

    // ---------- View-only share links ----------
    match /shares/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isMember(request.resource.data.tripId);
      allow delete: if isMember(resource.data.tripId);
    }

    // ---------- Legacy (v1) single plan, kept for import ----------
    match /planners/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
