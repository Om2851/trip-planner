rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's private plan: planners/{their uid}.
    match /planners/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // View-only share links: shares/{random id}.
    // Anyone who knows the exact id can read it (no listing/browsing of other shares).
    // Only the signed-in owner can create, update or delete it.
    match /shares/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
